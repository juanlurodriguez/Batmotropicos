---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica relativa, ej. "/catalogo" */
  path?: string;
  /** Excluye la página de buscadores (páginas ocultas, ej. /paciente) */
  noindex?: boolean;
  /** Cabecera y pie mínimos, sin navegación B2B ni widget de WhatsApp */
  minimal?: boolean;
}

const { title, description, path = '', noindex = false, minimal = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = `${title} · ${site.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/batmotropicos-icon-outline.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    {
      minimal ? (
        <header class="mini-hd">
          <span class="mini-hd__brand">
            <Icon size={32} />
            <span>
              <strong>Batmotrópicos</strong>
              <small>Health Services</small>
            </span>
          </span>
        </header>
      ) : (
        <Header />
      )
    }
    <main>
      <slot />
    </main>
    {
      minimal ? (
        <footer class="mini-ft">
          <span>© {site.name} {new Date().getFullYear()}</span>
          <a href="/privacidad">Privacidad</a>
        </footer>
      ) : (
        <>
          <Footer />
          <WhatsAppWidget />
        </>
      )
    }

    <!-- Reveal sobrio en scroll (IntersectionObserver, degrada sin JS).
         Incluye fallback por scroll: si el observer falla en algún dispositivo,
         ningún contenido puede quedarse oculto. -->
    <script is:inline>
      (function () {
        const els = Array.from(document.querySelectorAll('.reveal'));
        if (!els.length) return;
        let pending = els.slice();

        function show(el) {
          el.classList.add('is-visible');
        }
        function showAll() {
          pending.forEach(show);
          pending = [];
          window.removeEventListener('scroll', onScroll);
        }
        if (!('IntersectionObserver' in window)) {
          showAll();
          return;
        }

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                show(e.target);
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px 120px 0px' }
        );
        els.forEach((el) => obs.observe(el));

        // Fallback: en cada scroll, revela lo que ya está en pantalla aunque
        // el observer no haya disparado. Se autodesactiva al terminar.
        let ticking = false;
        function checkPending() {
          ticking = false;
          pending = pending.filter(function (el) {
            if (el.classList.contains('is-visible')) return false;
            const top = el.getBoundingClientRect().top;
            if (top < window.innerHeight + 120) {
              show(el);
              obs.unobserve(el);
              return false;
            }
            return true;
          });
          if (!pending.length) window.removeEventListener('scroll', onScroll);
        }
        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(checkPending);
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('load', onScroll);
      })();
    </script>

    <!-- Vídeos [data-autoplay]: se reproducen en silencio solo mientras están en
         pantalla (no descargan nada antes). Respeta reduced-motion y la pausa
         manual del usuario. Botón [data-unmute] opcional para activar el sonido. -->
    <script is:inline>
      (function () {
        var vids = document.querySelectorAll('video[data-autoplay]');
        if (!vids.length) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        vids.forEach(function (v) {
          v.muted = true;
          var userPaused = false;
          var autoPausing = false;
          v.addEventListener('pause', function () {
            if (!autoPausing && !v.ended) userPaused = true;
            autoPausing = false;
          });
          v.addEventListener('play', function () { userPaused = false; });

          var btn = v.parentElement && v.parentElement.querySelector('[data-unmute]');
          if (btn) {
            btn.addEventListener('click', function () {
              v.muted = false;
              v.currentTime = 0;
              userPaused = false;
              v.play();
              btn.hidden = true;
            });
            v.addEventListener('volumechange', function () {
              if (!v.muted) btn.hidden = true;
            });
          }

          if (reduce || !('IntersectionObserver' in window)) return;
          new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  if (!userPaused) v.play().catch(function () {});
                } else if (!v.paused) {
                  autoPausing = true;
                  v.pause();
                }
              });
            },
            { threshold: 0.4 }
          ).observe(v);
        });
      })();
    </script>
  </body>
</html>

<style>
  .mini-hd {
    display: flex;
    justify-content: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .mini-hd__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--green);
    line-height: 1.1;
  }
  .mini-hd__brand strong {
    display: block;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .mini-hd__brand small {
    display: block;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .mini-ft {
    display: flex;
    justify-content: center;
    gap: 18px;
    padding: 22px 16px 28px;
    font-size: 12px;
    color: var(--text-sec);
  }
  .mini-ft a {
    color: var(--text-sec);
  }
</style>
