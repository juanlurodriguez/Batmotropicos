---
// ════════════════════════════════════════════════════════════
// CASO REAL · Semana del Housekeeping en Club Mac Alcúdia
// Vídeo vertical editado por Club Mac (subtitulado) + historia y
// testimonio. Se usa en la home, /hoteles y como referencia en casos.
// El vídeo no se descarga hasta que el usuario pulsa play (preload="none").
// ════════════════════════════════════════════════════════════

interface Props {
  /** Destino del CTA principal */
  ctaHref?: string;
  /** Texto del CTA principal */
  ctaLabel?: string;
  /** Fondo suave para alternar con la sección anterior */
  soft?: boolean;
}

const {
  ctaHref = '/diagnostico',
  ctaLabel = 'Quiero algo así para mi equipo',
  soft = false,
} = Astro.props;

const LINKEDIN =
  'https://www.linkedin.com/posts/mac-hotels_housekeeping-machotels-employerbranding-activity-7506690399311208448-Js7x';
---

<section class={soft ? 'section section--soft' : 'section'}>
  <div class="wrap cm">
    <div class="cm__media reveal">
      <video
        class="cm__video"
        src="/assets/casos/club-mac-housekeeping.mp4"
        poster="/assets/casos/club-mac-housekeeping-poster.jpg"
        width="640"
        height="1138"
        controls
        muted
        loop
        playsinline
        preload="none"
        data-autoplay
        aria-label="Vídeo de la Semana del Housekeeping en Club Mac Alcúdia, con testimonios del equipo de pisos"
      ></video>
      <button type="button" class="cm__unmute" data-unmute>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/></svg>
        Activar sonido
      </button>
    </div>

    <div class="cm__body reveal">
      <p class="eyebrow">Caso real · Hostelería</p>
      <h2 class="h2 cm__title">Semana del Housekeeping en Club Mac Alcúdia</h2>
      <p class="cm__lead">
        73 personas del equipo de pisos formadas en autocuidado preventivo, higiene postural y
        calentamiento, en un programa piloto de salud laboral con Mac Hotels.
      </p>

      <ul class="cm__stats" aria-label="Datos del programa">
        <li><strong>73</strong><span>personas formadas</span></li>
        <li><strong>Pisos</strong><span>el equipo que sostiene el hotel</span></li>
        <li><strong>Piloto</strong><span>primera fase del programa</span></li>
      </ul>

      <p class="cm__story">
        Antes de ser fisioterapeuta trabajé años en hostelería. En consulta empecé a repetir el
        mismo diagnóstico en camareras de piso: mismo hombro, misma espalda, mismo agotamiento. No
        era mala suerte, era un patrón. Y los patrones no se ignoran: se rompen.
      </p>

      <figure class="cm__quote">
        <blockquote>
          “Dar a nuestros profesionales las herramientas necesarias para trabajar con salud y
          seguridad es, sin duda, nuestra mejor inversión.”
        </blockquote>
        <figcaption>
          Mac Hotels ·
          <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">ver la publicación en LinkedIn</a>
        </figcaption>
      </figure>

      <a href={ctaHref} class="btn btn--primary">{ctaLabel} <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<style>
  .cm {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .cm__media {
    width: 100%;
    position: relative;
  }
  .cm__unmute {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font);
    font-weight: 600;
    font-size: 13px;
    color: #fff;
    background: rgba(17, 17, 17, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
    padding: 8px 14px;
    cursor: pointer;
    backdrop-filter: blur(4px);
    white-space: nowrap;
  }
  .cm__unmute:hover {
    background: var(--green);
    border-color: var(--green);
  }
  .cm__unmute[hidden] {
    display: none;
  }
  .cm__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 1138;
    background: #111;
    border-radius: var(--radius);
    box-shadow: var(--shadow-hover);
    object-fit: cover;
  }
  .cm__title {
    margin-bottom: 12px;
  }
  .cm__lead {
    font-size: 16.5px;
    color: var(--text);
    line-height: 1.65;
    margin: 0 0 22px;
  }
  .cm__stats {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cm__stats li {
    background: #fff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--green);
    border-radius: var(--radius-sm);
    padding: 12px 12px 11px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .cm__stats strong {
    font-weight: 700;
    font-size: 20px;
    color: var(--green);
    line-height: 1.1;
  }
  .cm__stats span {
    font-size: 12px;
    color: var(--text-sec);
    line-height: 1.35;
  }
  .cm__story {
    font-size: 14.5px;
    color: var(--text-sec);
    line-height: 1.7;
    margin: 0 0 20px;
  }
  .cm__quote {
    margin: 0 0 24px;
    padding: 4px 0 4px 18px;
    border-left: 3px solid var(--green);
  }
  .cm__quote blockquote {
    margin: 0 0 6px;
    font-weight: 600;
    font-size: 17px;
    color: var(--text);
    line-height: 1.45;
  }
  .cm__quote figcaption {
    font-size: 12.5px;
    color: var(--text-sec);
  }
  .cm__quote figcaption a {
    color: var(--green);
    font-weight: 600;
  }

  @media (max-width: 880px) {
    .cm {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cm__media {
      max-width: 300px;
      margin: 0 auto;
    }
  }
  @media (max-width: 420px) {
    .cm__stats strong {
      font-size: 17px;
    }
  }
</style>
