---
// ════════════════════════════════════════════════════════════
// RUEDA DE BIENESTAR CORPORATIVO — 8 áreas en dos mitades
// Arriba "La persona" (físico, mental, propósito, financiero);
// abajo "El equipo" (cohesión, comunicación, liderazgo, obligatoria).
// Cada área dice a RRHH qué indicador mejora y si es bonificable.
// Desktop: rueda SVG interactiva + panel lateral con detalle.
// Móvil: rueda SVG táctil (tocar un área abre su tarjeta) + tarjetas desplegables.
// El SVG se genera en build; el JS runtime solo gestiona la selección.
// Cero dependencias. Los CTAs usan las anclas reales del catálogo.
// ════════════════════════════════════════════════════════════
import { BONIF_NOTE } from '../data/catalogo';

type Group = 'p' | 'e';

interface Area {
  /** Número visual 01-08 */
  n: string;
  /** Mitad de la rueda: p = la persona, e = el equipo */
  g: Group;
  /** Etiqueta corta para el segmento de la rueda */
  short: string;
  /** Icono (contenido SVG, viewBox 24, trazo) */
  icon: string;
  /** Nombre completo del área */
  name: string;
  /** Descripción breve */
  desc: string;
  /** Qué indicadores de RRHH mejora */
  mejora: string;
  /** Ejemplos (máx. 5) */
  ex: string[];
  /** Sello de bonificación */
  bonif: string;
  /** Ancla del catálogo para "Ver acciones" */
  anchor: string;
  /** Enlace secundario opcional dentro de la tarjeta */
  extra?: { label: string; anchor: string };
}

const GROUPS: Record<Group, string> = { p: 'La persona', e: 'El equipo' };

const AREAS: Area[] = [
  {
    n: '01',
    g: 'p',
    short: 'Físico',
    icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    name: 'Salud física, nutrición y descanso',
    desc: 'Menos molestias y más energía: ergonomía, movimiento, alimentación y descanso aplicados al puesto.',
    mejora: 'Bajas por lesiones musculoesqueléticas, absentismo y fatiga en los puestos físicos.',
    ex: ['Ergonomía', 'Pausas activas', 'Espalda sana', 'Alimentación y sueño', 'Fisioterapia in company'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#salud-fisica',
    extra: { label: 'Wellness in company', anchor: '#wellness-in-company' },
  },
  {
    n: '02',
    g: 'p',
    short: 'Mental',
    icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
    name: 'Salud mental y emocional',
    desc: 'Herramientas para gestionar la presión y prevenir el desgaste antes de que se convierta en baja.',
    mejora: 'Estrés, bajas por ansiedad o burnout y presentismo.',
    ex: ['Gestión del estrés', 'Regulación emocional', 'Respiración', 'Mindfulness', 'Yoga y pilates'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#salud-mental',
  },
  {
    n: '03',
    g: 'p',
    short: 'Propósito',
    icon: '<circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3z"/>',
    name: 'Propósito y autoconocimiento',
    desc: 'Taller Ikigai: cada persona descubre qué la mueve, en qué es buena y cómo conectarlo con su trabajo.',
    mejora: 'Motivación, compromiso y retención del talento.',
    ex: ['Ikigai', 'Autoconocimiento', 'Motivación', 'Sentido del trabajo'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#proposito',
  },
  {
    n: '04',
    g: 'p',
    short: 'Financiero',
    icon: '<path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>',
    name: 'Bienestar financiero',
    desc: 'Entender la nómina, ahorrar y decidir mejor. Menos preocupación económica, más cabeza en el trabajo.',
    mejora: 'Estrés económico, concentración y valor percibido de la nómina.',
    ex: ['Entiende tu nómina', 'Ahorro', 'Deuda', 'Estrés financiero', 'Prevención de fraudes'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#bienestar-financiero',
  },
  {
    n: '05',
    g: 'e',
    short: 'Cohesión',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
    name: 'Cohesión y team building',
    desc: 'Experiencias que crean confianza y pertenencia entre personas y departamentos.',
    mejora: 'Clima laboral, pertenencia y colaboración entre departamentos.',
    ex: ['Team building', 'Dinámicas de cohesión', 'Jornadas deportivas', 'Escape room', 'MasterChef y paellas'],
    bonif: 'Parcialmente bonificable*',
    anchor: '#team-building',
  },
  {
    n: '06',
    g: 'e',
    short: 'Comunicación',
    icon: '<path d="M21 11.5a8.4 8.4 0 0 1-12.1 7.5L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5Z"/>',
    name: 'Comunicación y negociación',
    desc: 'Equipos que se entienden, resuelven conflictos y negocian mejor, dentro de la empresa y con el cliente.',
    mejora: 'Conflictos internos, coordinación entre áreas y resultados comerciales.',
    ex: ['Comunicación asertiva', 'Gestión de conflictos', 'Negociación', 'Atención al cliente', 'Inglés profesional'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#liderazgo-comunicacion',
  },
  {
    n: '07',
    g: 'e',
    short: 'Liderazgo',
    icon: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>',
    name: 'Liderazgo y gestión de equipos',
    desc: 'La gente no deja empresas, deja jefes. Formamos mandos que cuidan, motivan y exigen sin quemar al equipo.',
    mejora: 'Rotación, clima en cada equipo y retención de los buenos perfiles.',
    ex: ['Liderazgo', 'Gestión de equipos', 'Gestión de conflictos'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#liderazgo-comunicacion',
  },
  {
    n: '08',
    g: 'e',
    short: 'Obligatoria',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>',
    name: 'Formación obligatoria y prevención',
    desc: 'Todo lo que la ley te exige, documentado y con un solo proveedor. Sin coordinar a cinco empresas distintas.',
    mejora: 'Cumplimiento legal, inspecciones sin sustos y seguridad de las personas.',
    ex: ['PRL', 'Igualdad y protocolo de acoso', 'Primeros auxilios y DEA', 'Manipulación de alimentos', 'Socorrismo'],
    bonif: 'Bonificable FUNDAE*',
    anchor: '#cumplimiento-prevencion',
  },
];

// Geometría de la rueda (SVG 440×440, donut de 8 segmentos).
// Empieza a las 9 en punto: los 4 primeros forman la mitad de arriba
// (la persona) y los 4 últimos la de abajo (el equipo).
const C = 220;
const R = 178;
const r = 104;
const GAP = 2.4;
const START = -180;
const rad = (a: number) => (a * Math.PI) / 180;
const pt = (a: number, rr: number) =>
  `${(C + rr * Math.cos(rad(a))).toFixed(2)} ${(C + rr * Math.sin(rad(a))).toFixed(2)}`;

const segs = AREAS.map((_, i) => {
  const a0 = START + i * 45 + GAP / 2;
  const a1 = START + (i + 1) * 45 - GAP / 2;
  const d = `M ${pt(a0, R)} A ${R} ${R} 0 0 1 ${pt(a1, R)} L ${pt(a1, r)} A ${r} ${r} 0 0 0 ${pt(a0, r)} Z`;
  const mid = START + i * 45 + 22.5;
  const lr = (R + r) / 2;
  return {
    d,
    lx: +(C + lr * Math.cos(rad(mid))).toFixed(2),
    ly: +(C + lr * Math.sin(rad(mid))).toFixed(2),
  };
});

// Rótulos de cada mitad, por fuera del anillo. Arriba se recorre de
// izquierda a derecha por encima; abajo, de izquierda a derecha por
// debajo, para que los dos se lean derechos.
const RT = R + 9;
const RB = R + 19;
const ARC_TOP = `M ${C - RT} ${C} A ${RT} ${RT} 0 0 1 ${C + RT} ${C}`;
const ARC_BOT = `M ${C - RB} ${C} A ${RB} ${RB} 0 0 0 ${C + RB} ${C}`;


// Isotipo Batmotrópicos (corazón + rayo) — trazados de Icon.astro,
// incrustados en el hub de la rueda. El glifo ocupa x≈191-815, y≈172-818
// dentro de su caja 1024, con centro aproximado en (503, 495).
const ICON_P1 =
  'M 745 280 L 654 403 L 587 489 L 647 510 L 648 513 L 411 736 L 327 818 L 454 735 L 457 735 L 473 743 L 503 754 L 539 763 L 581 768 L 609 768 L 631 766 L 672 757 L 710 741 L 744 718 L 761 702 L 772 689 L 785 670 L 797 645 L 805 613 L 806 587 L 803 562 L 799 547 L 792 530 L 779 510 L 759 490 L 747 481 L 747 479 L 767 460 L 775 449 L 783 433 L 790 409 L 791 376 L 786 349 L 778 327 L 765 304 Z';
const ICON_P2 =
  'M 815 172 L 708 247 L 677 232 L 645 220 L 616 213 L 593 210 L 555 210 L 518 216 L 480 229 L 456 241 L 415 269 L 375 303 L 311 363 L 239 434 L 198 477 L 192 485 L 191 497 L 194 504 L 216 535 L 250 576 L 310 638 L 338 663 L 366 685 L 396 705 L 408 711 L 461 644 L 534 546 L 473 525 L 472 522 L 533 464 L 703 295 Z';
const ICON_S = 0.071;
const ICON_TX = +(C - 503 * ICON_S).toFixed(2);
const ICON_TY = +(172 - 495 * ICON_S).toFixed(2);
---

<!-- Sin clase "reveal": esta sección es estratégica y no debe depender
     de la animación de scroll para ser visible en ningún dispositivo. -->
<div class="ww">
  <!-- Desktop: rueda + panel lateral -->
  <div class="ww-desk">
    <div class="ww-wheelbox">
      <svg viewBox="0 0 440 440" class="ww-svg" aria-label="Rueda con las 8 áreas del bienestar corporativo">
        <defs>
          <path id="ww-at-d" d={ARC_TOP}></path>
          <path id="ww-ab-d" d={ARC_BOT}></path>
        </defs>
        <text class="ww-half g-p"><textPath href="#ww-at-d" startOffset="50%">{GROUPS.p}</textPath></text>
        <text class="ww-half g-e"><textPath href="#ww-ab-d" startOffset="50%">{GROUPS.e}</textPath></text>
        {
          AREAS.map((a, i) => (
            <path
              d={segs[i].d}
              class={`ww-seg g-${a.g}${i % 2 ? ' alt' : ''}${i === 0 ? ' sel' : ''}`}
              data-ww-seg={i}
              tabindex="0"
              role="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`${a.name}: ver detalle`}
            />
          ))
        }
        {
          AREAS.map((a, i) => (
            <g class={`ww-lbl g-${a.g}${i === 0 ? ' on' : ''}`} data-ww-lb={i}>
              <svg x={segs[i].lx - 10} y={segs[i].ly - 24} width="20" height="20" viewBox="0 0 24 24" class="ww-ico" set:html={a.icon} />
              <text x={segs[i].lx} y={segs[i].ly + 12} class="ww-slb">{a.short}</text>
            </g>
          ))
        }
        <circle cx={C} cy={C} r={r - 12} class="ww-hub"></circle>
        <g transform={`translate(${ICON_TX} ${ICON_TY}) scale(${ICON_S})`} class="ww-hub-icon" aria-hidden="true">
          <path d={ICON_P1}></path>
          <path d={ICON_P2}></path>
        </g>
        <text x={C} y={C + 8} class="ww-hub-title">Equipos que están</text>
        <text x={C} y={C + 27} class="ww-hub-title">bien, rinden</text>
        <text x={C} y={C + 46} class="ww-hub-title">y se quedan</text>
      </svg>
      <p class="ww-hint">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11V5a2 2 0 0 1 4 0v5"/><path d="M13 10V9a2 2 0 0 1 4 0v2"/><path d="M17 11a2 2 0 0 1 4 0v4a7 7 0 0 1-7 7h-1.5a7 7 0 0 1-5.6-2.8L4 15.5a2 2 0 0 1 3-2.6L9 15"/></svg>
        Pasa por cada área para ver qué mejora en tu empresa
      </p>
    </div>
    <div class="ww-panel" aria-live="polite">
      {
        AREAS.map((a, i) => (
          <div class={`ww-card g-${a.g}`} data-ww-card={i} hidden={i !== 0}>
            <p class="ww-eyebrow">{GROUPS[a.g]} · Área {a.n}</p>
            <h3 class="ww-name">{a.name}</h3>
            <p class="ww-desc">{a.desc}</p>
            <div class="ww-mejora">
              <span class="ww-mejora__k">Qué mejora</span>
              <span class="ww-mejora__v">{a.mejora}</span>
            </div>
            <div class="ww-chips">
              {a.ex.map((e) => (
                <span class="ww-chip">{e}</span>
              ))}
            </div>
            <p class="ww-bonif">{a.bonif}</p>
            <div class="ww-cta">
              <a href="/diagnostico" class="btn btn--primary btn--sm">
                Diagnosticar mi equipo <span class="arrow">→</span>
              </a>
              <a href={a.anchor} class="btn btn--outline btn--sm" data-scroll>
                Ver acciones del catálogo
              </a>
              {a.extra && (
                <a href={a.extra.anchor} class="ww-extralink" data-scroll>
                  {a.extra.label} <span class="arrow">→</span>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Móvil: rueda táctil + tarjetas desplegables -->
  <div class="ww-mobile">
    <div class="ww-mwheel">
      <svg viewBox="0 0 440 440" class="ww-svg" aria-label="Rueda con las 8 áreas del bienestar corporativo">
        <defs>
          <path id="ww-at-m" d={ARC_TOP}></path>
          <path id="ww-ab-m" d={ARC_BOT}></path>
        </defs>
        <text class="ww-half g-p"><textPath href="#ww-at-m" startOffset="50%">{GROUPS.p}</textPath></text>
        <text class="ww-half g-e"><textPath href="#ww-ab-m" startOffset="50%">{GROUPS.e}</textPath></text>
        {
          AREAS.map((a, i) => (
            <path
              d={segs[i].d}
              class={`ww-seg g-${a.g}${i % 2 ? ' alt' : ''}${i === 0 ? ' sel' : ''}`}
              data-ww-mseg={i}
              tabindex="0"
              role="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`${a.name}: abrir detalle`}
            />
          ))
        }
        {
          AREAS.map((a, i) => (
            <g class={`ww-lbl ww-lbl--m g-${a.g}${i === 0 ? ' on' : ''}`} data-ww-mlb={i}>
              <svg x={segs[i].lx - 11} y={segs[i].ly - 26} width="22" height="22" viewBox="0 0 24 24" class="ww-ico" set:html={a.icon} />
              <text x={segs[i].lx} y={segs[i].ly + 13} class="ww-slb">{a.short}</text>
            </g>
          ))
        }
        <circle cx={C} cy={C} r={r - 12} class="ww-hub"></circle>
        <g transform={`translate(${ICON_TX} ${ICON_TY}) scale(${ICON_S})`} class="ww-hub-icon" aria-hidden="true">
          <path d={ICON_P1}></path>
          <path d={ICON_P2}></path>
        </g>
        <text x={C} y={C + 8} class="ww-hub-title">Equipos que están</text>
        <text x={C} y={C + 27} class="ww-hub-title">bien, rinden</text>
        <text x={C} y={C + 46} class="ww-hub-title">y se quedan</text>
      </svg>
      <p class="ww-hint">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11V5a2 2 0 0 1 4 0v5"/><path d="M13 10V9a2 2 0 0 1 4 0v2"/><path d="M17 11a2 2 0 0 1 4 0v4a7 7 0 0 1-7 7h-1.5a7 7 0 0 1-5.6-2.8L4 15.5a2 2 0 0 1 3-2.6L9 15"/></svg>
        Toca un área para ver qué mejora en tu empresa
      </p>
    </div>
    {
      AREAS.map((a, i) => (
        <details class={`ww-mi g-${a.g}`} data-ww-mi={i} open={i === 0}>
          <summary class="ww-ms">
            <span class="ww-num" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={a.icon} />
            </span>
            <span class="ww-mt">
              <span class="ww-mg">{GROUPS[a.g]}</span>
              {a.name}
            </span>
            <span class="ww-chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="ww-mb">
            <p class="ww-desc">{a.desc}</p>
            <div class="ww-mejora">
              <span class="ww-mejora__k">Qué mejora</span>
              <span class="ww-mejora__v">{a.mejora}</span>
            </div>
            <div class="ww-chips">
              {a.ex.map((e) => (
                <span class="ww-chip">{e}</span>
              ))}
            </div>
            <p class="ww-bonif">{a.bonif}</p>
            <div class="ww-cta">
              <a href="/diagnostico" class="btn btn--primary btn--sm">
                Diagnosticar mi equipo <span class="arrow">→</span>
              </a>
              <a href={a.anchor} class="btn btn--outline btn--sm" data-scroll>
                Ver acciones del catálogo
              </a>
              {a.extra && (
                <a href={a.extra.anchor} class="ww-extralink" data-scroll>
                  {a.extra.label} <span class="arrow">→</span>
                </a>
              )}
            </div>
          </div>
        </details>
      ))
    }
  </div>

  <p class="ww-note">* {BONIF_NOTE}</p>
</div>

<style>
  .ww {
    margin-top: 16px;
    /* Dos tonos dentro de la marca: verde para la persona, verde azulado para el equipo */
    --ww-p: var(--green);
    --ww-p-dark: var(--green-dark);
    --ww-p-rgb: 26, 92, 26;
    --ww-e: #17696c;
    --ww-e-dark: #0f4446;
    --ww-e-rgb: 23, 119, 122;
  }
  .g-p {
    --c: var(--ww-p);
    --c-dark: var(--ww-p-dark);
    --c-rgb: var(--ww-p-rgb);
  }
  .g-e {
    --c: var(--ww-e);
    --c-dark: var(--ww-e-dark);
    --c-rgb: var(--ww-e-rgb);
  }

  /* ── Desktop: rueda + panel ── */
  .ww-desk {
    display: none;
  }
  .ww-svg {
    display: block;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    font-family: var(--font);
  }
  path.ww-seg {
    fill: rgba(var(--c-rgb), 0.1);
    stroke: #fff;
    stroke-width: 3;
    cursor: pointer;
    transition: fill 0.15s ease;
  }
  path.ww-seg.alt {
    fill: rgba(var(--c-rgb), 0.18);
  }
  path.ww-seg:hover {
    fill: rgba(var(--c-rgb), 0.32);
  }
  path.ww-seg:focus-visible {
    outline: none;
    fill: rgba(var(--c-rgb), 0.32);
    stroke: var(--c-dark);
    stroke-width: 2;
  }
  path.ww-seg.sel {
    fill: var(--c);
  }
  .ww-lbl {
    pointer-events: none;
  }
  .ww-ico {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .ww-slb {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--c-dark);
    text-anchor: middle;
  }
  .ww-lbl.on .ww-slb {
    fill: #fff;
  }
  .ww-lbl.on .ww-ico {
    stroke: #fff;
  }
  .ww-half {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    fill: var(--c);
    text-anchor: middle;
  }
  .ww-hub {
    fill: #fff;
    stroke: var(--line);
  }
  .ww-hub-icon {
    pointer-events: none;
  }
  .ww-hub-icon path {
    fill: none;
    stroke: var(--green);
    stroke-width: 12;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ww-hub-title {
    font-size: 15.5px;
    font-weight: 700;
    fill: var(--text);
    text-anchor: middle;
    pointer-events: none;
  }
  .ww-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--green);
    text-align: center;
    margin: 10px 0 0;
  }
  .ww-hint svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ww-panel {
    min-height: 440px;
    display: flex;
    align-items: center;
  }
  .ww-card {
    width: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--c);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 24px 24px 22px;
    animation: wwFade 0.24s ease;
  }
  .ww-card[hidden] {
    display: none;
  }
  @keyframes wwFade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .ww-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
    margin: 0 0 8px;
  }
  .ww-name {
    font-size: 19px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .ww-desc {
    font-size: 14px;
    color: var(--text-sec);
    line-height: 1.55;
    margin: 0 0 14px;
  }
  /* Lo que RRHH quiere leer: el indicador que mejora */
  .ww-mejora {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: rgba(var(--c-rgb), 0.07);
    border-left: 3px solid var(--c);
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
    margin: 0 0 14px;
  }
  .ww-mejora__k {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c);
  }
  .ww-mejora__v {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.45;
  }
  .ww-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
  }
  .ww-chip {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--c-dark);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 4px 10px;
  }
  .ww-bonif {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--green-accent);
    margin: 0 0 16px;
  }
  .ww-bonif::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green-accent);
  }
  .ww-cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: stretch;
  }
  .ww-cta .btn {
    justify-content: center;
  }
  .ww-extralink {
    font-size: 13px;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
    text-align: center;
    padding: 2px 0;
  }
  .ww-extralink:hover {
    text-decoration: underline;
  }
  .ww-note {
    font-size: 11.5px;
    color: var(--text-sec);
    line-height: 1.5;
    margin: 18px 0 0;
  }

  /* ── Móvil: rueda táctil + tarjetas desplegables ── */
  .ww-mobile {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ww-mwheel {
    max-width: 380px;
    width: 100%;
    margin: 0 auto 10px;
  }
  /* Etiquetas algo mayores: la rueda móvil se renderiza más pequeña. */
  .ww-lbl--m .ww-slb {
    font-size: 14.5px;
  }
  .ww-half {
    font-size: 11px;
  }
  .ww-mi {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .ww-mi[open] {
    border-color: rgba(var(--c-rgb), 0.45);
  }
  .ww-ms {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    cursor: pointer;
    list-style: none;
  }
  .ww-ms::-webkit-details-marker {
    display: none;
  }
  .ww-num {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border: 1.5px solid var(--c);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .ww-num svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ww-mi[open] .ww-num {
    background: var(--c);
    color: #fff;
  }
  .ww-mt {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  .ww-mg {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c);
  }
  .ww-chev {
    color: var(--c);
    display: flex;
    align-items: center;
    transition: transform 0.18s ease;
  }
  .ww-chev svg {
    width: 18px;
    height: 18px;
  }
  .ww-mi[open] .ww-chev {
    transform: rotate(180deg);
  }
  .ww-mb {
    padding: 0 16px 16px;
  }

  @media (min-width: 980px) {
    .ww-desk {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 32px;
      align-items: center;
    }
    .ww-mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-seg,
    .ww-num,
    .ww-chev {
      transition: none;
    }
    .ww-card {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // ── Desktop: rueda + panel lateral ──
    var segs = document.querySelectorAll('[data-ww-seg]');
    var labels = document.querySelectorAll('[data-ww-lb]');
    var cards = document.querySelectorAll('[data-ww-card]');

    function select(i) {
      segs.forEach(function (p) {
        var on = p.getAttribute('data-ww-seg') === String(i);
        p.classList.toggle('sel', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      labels.forEach(function (t) {
        t.classList.toggle('on', t.getAttribute('data-ww-lb') === String(i));
      });
      cards.forEach(function (c) {
        c.hidden = c.getAttribute('data-ww-card') !== String(i);
      });
    }

    segs.forEach(function (p) {
      var i = parseInt(p.getAttribute('data-ww-seg'), 10);
      p.addEventListener('click', function () {
        select(i);
      });
      p.addEventListener('mouseenter', function () {
        select(i);
      });
      p.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(i);
        }
      });
    });

    // ── Móvil: rueda táctil sincronizada con las tarjetas ──
    var msegs = document.querySelectorAll('[data-ww-mseg]');
    var mlabels = document.querySelectorAll('[data-ww-mlb]');
    var mitems = document.querySelectorAll('[data-ww-mi]');
    if (!msegs.length) return;

    function mhighlight(i) {
      msegs.forEach(function (p) {
        var on = p.getAttribute('data-ww-mseg') === String(i);
        p.classList.toggle('sel', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      mlabels.forEach(function (t) {
        t.classList.toggle('on', t.getAttribute('data-ww-mlb') === String(i));
      });
    }

    function mopen(i) {
      mhighlight(i);
      var target = null;
      mitems.forEach(function (d) {
        var on = d.getAttribute('data-ww-mi') === String(i);
        d.open = on;
        if (on) target = d;
      });
      if (target && target.scrollIntoView) {
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    msegs.forEach(function (p) {
      var i = parseInt(p.getAttribute('data-ww-mseg'), 10);
      p.addEventListener('click', function () {
        mopen(i);
      });
      p.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          mopen(i);
        }
      });
    });

    // Abrir una tarjeta a mano también resalta su área en la rueda.
    mitems.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) mhighlight(parseInt(d.getAttribute('data-ww-mi'), 10));
      });
    });
  })();
</script>
