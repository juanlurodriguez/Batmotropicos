---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { catalogo, BONIF_NOTE } from '../data/catalogo';

const totalItems = catalogo.reduce((n, c) => n + c.items.length, 0);

// Líneas de servicio. `href` lleva a la categoría del catálogo (se abre sola)
// o a la página específica. `icon` son trazados SVG de 24×24.
const servicios = [
  {
    t: 'Formación bonificable',
    d: 'Acciones presenciales y online diseñadas para encajar en el crédito FUNDAE: salud, habilidades, prevención y cumplimiento.',
    href: '/fundae',
    cta: 'Cómo funciona la bonificación',
    icon: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  },
  {
    t: 'Salud física y mental',
    d: 'Ergonomía, pausas activas, gestión del estrés y hábitos saludables aplicados al puesto real del equipo.',
    href: '/catalogo#salud-fisica',
    cta: 'Ver acciones',
    icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/><path d="M3.2 12H8l1.5-3 3 6 1.5-3h6.8"/>',
  },
  {
    t: 'Wellness in company',
    d: 'Fisioterapia, psicología, yoga y movilidad en tus instalaciones. Sesiones recurrentes, bolsa de horas o copago.',
    href: '/catalogo#wellness-in-company',
    cta: 'Ver servicios',
    icon: '<circle cx="12" cy="4.5" r="2"/><path d="M4 9.5c2.7 1 5.3 1.5 8 1.5s5.3-.5 8-1.5"/><path d="M12 11v4l-3 6"/><path d="m12 15 3 6"/>',
  },
  {
    t: 'Team building y cohesión',
    d: 'Experiencias para activar, conectar y reforzar el sentimiento de equipo, adaptadas al grupo y al momento.',
    href: '/team-building',
    cta: 'Ver experiencias',
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  },
  {
    t: 'Productividad, IA y liderazgo',
    d: 'Inteligencia artificial aplicada, organización del trabajo, comunicación y liderazgo de equipos.',
    href: '/catalogo#productividad-digital',
    cta: 'Ver acciones',
    icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
  },
  {
    t: 'Cumplimiento y prevención',
    d: 'PRL, primeros auxilios, igualdad y protocolos, con toda la documentación gestionada y ordenada.',
    href: '/catalogo#cumplimiento-prevencion',
    cta: 'Ver formaciones',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  },
];

const proceso = [
  ['Diagnóstico', 'Analizamos las necesidades reales del equipo y de la empresa.'],
  ['Diseño', 'Plan a medida con acciones, formato y calendario.'],
  ['Gestión FUNDAE', 'Si aplica, revisamos el encaje y preparamos la documentación antes de empezar.'],
  ['Ejecución', 'Presencial u online, con profesionales especializados.'],
  ['Medición', 'KPIs, feedback del equipo y memoria de resultados para dirección.'],
];

const beneficios = [
  ['Menos desgaste físico y mental', 'Menos molestias y estrés crónico, más energía en la jornada.'],
  ['Menos absentismo', 'La prevención reduce bajas ligadas al entorno de trabajo.'],
  ['Mejor clima', 'Un equipo que se cuida coopera mejor y discute menos.'],
  ['Más pertenencia', 'Cuando la empresa cuida de verdad, las personas se quedan.'],
  ['Atrae y retiene talento', 'Un argumento diferencial frente al sueldo y condiciones estándar.'],
  ['Un solo interlocutor', 'Formación, bienestar y cohesión con un único equipo.'],
];

const fundaeFaqs = [
  [
    '¿La formación tiene coste?',
    'Sí. Toda formación tiene un coste real. Lo que ocurre es que muchas acciones pueden bonificarse a través del crédito formativo del que dispone cada empresa, lo que puede reducir —o en algunos casos eliminar— el coste neto.',
  ],
  [
    '¿Qué es el crédito formativo FUNDAE?',
    'Es el crédito anual que cada empresa puede destinar a la formación de sus trabajadoras y trabajadores. Su importe depende de las cotizaciones a la Seguridad Social del ejercicio anterior. No es ilimitado: depende del tamaño de la empresa y del número de acciones.',
  ],
  [
    '¿Puede llegar a coste cero para la empresa?',
    'En determinados casos sí, cuando el crédito es suficiente y la acción cumple todos los requisitos. No es una garantía, pero es una posibilidad real que revisamos desde el primer momento.',
  ],
  [
    '¿Batmotrópicos gestiona la documentación?',
    'Sí. Revisamos el encaje de cada acción, preparamos la documentación conforme a la normativa vigente y acompañamos los plazos para que todo quede en regla antes de empezar.',
  ],
];
---

<BaseLayout
  title="Qué hacemos"
  description="Formación bonificable, salud física y mental, wellness in company, team building, productividad y cumplimiento para empresas. Un solo equipo que diseña, ejecuta y mide."
  path="/que-hacemos"
>
  <!-- Hero -->
  <section class="section qh-hero">
    <div class="wrap qh-hero__grid">
      <div class="reveal">
        <p class="eyebrow">Qué hacemos</p>
        <h1 class="h2 qh-hero__title">Una sola propuesta para cuidar, formar y cohesionar al equipo</h1>
        <p class="lead">
          Formación, bienestar y cohesión coordinados por un solo equipo: menos proveedores que
          gestionar y más coherencia en lo que se hace.
        </p>
        <div class="qh-hero__actions">
          <a href="/diagnostico" class="btn btn--primary">Hacer el diagnóstico (2 min) <span class="arrow">→</span></a>
          <a href="/catalogo" class="btn btn--outline">Ver catálogo</a>
        </div>
        <ul class="qh-hero__facts" aria-label="En cifras">
          <li><strong>{totalItems}</strong> acciones</li>
          <li><strong>{catalogo.length}</strong> áreas</li>
          <li><strong>1</strong> solo equipo</li>
        </ul>
      </div>

      <div class="qh-collage reveal" aria-hidden="true">
        <img
          class="qh-collage__main"
          src="/assets/img/real/kokomo-formacion.webp"
          alt=""
          width="1200"
          height="2133"
          loading="eager"
          decoding="async"
        />
        <img
          class="qh-collage__inset"
          src="/assets/img/real/clubmac-calentamiento.webp"
          alt=""
          width="640"
          height="1138"
          loading="lazy"
          decoding="async"
        />
        <span class="qh-collage__badge">Sesiones en el propio espacio de trabajo</span>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="qh-head reveal">
        <div>
          <p class="eyebrow">Líneas de servicio</p>
          <h2 class="h2" style="margin-bottom:0">Seis formas de cuidar al equipo</h2>
        </div>
        <p class="qh-head__sub">
          Se combinan en un mismo plan según lo que necesite cada empresa. Toca una para ver sus
          acciones.
        </p>
      </div>
      <div class="svc reveal">
        {
          servicios.map((s, i) => (
            <a href={s.href} class={i === 0 ? 'svc__card svc__card--dark' : 'svc__card'}>
              <span class="svc__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </span>
              <h3 class="svc__title">{s.t}</h3>
              <p class="svc__desc">{s.d}</p>
              <span class="svc__cta">{s.cta} <span class="arrow">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Método -->
  <section class="section">
    <div class="wrap">
      <div class="reveal" style="max-width:680px">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="h2">Del diagnóstico a los resultados</h2>
        <p class="lead">
          Cinco pasos, del análisis inicial al cierre documentado, con la bonificación resuelta
          antes de ejecutar.
        </p>
      </div>
      <ol class="steps reveal">
        {
          proceso.map(([t, d], i) => (
            <li class="steps__item">
              <span class="steps__dot">{i + 1}</span>
              <h3 class="steps__title">{t}</h3>
              <p class="steps__desc">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="section section--dark qh-ben">
    <div class="wrap">
      <div class="reveal" style="max-width:680px">
        <p class="eyebrow eyebrow--light">Beneficios</p>
        <h2 class="h2 h2--light">Lo que gana la empresa</h2>
      </div>
      <ul class="gains reveal">
        {
          beneficios.map(([t, d]) => (
            <li>
              <span class="gains__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
              </span>
              <div>
                <h3 class="gains__title">{t}</h3>
                <p class="gains__desc">{d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FUNDAE FAQ -->
  <section class="section section--soft">
    <div class="wrap faqwrap">
      <div class="faqwrap__intro reveal">
        <p class="eyebrow">Bonificación FUNDAE</p>
        <h2 class="h2">Lo que conviene saber antes de planificar</h2>
        <p class="card-text" style="font-size:15.5px; margin-bottom:22px">
          La formación tiene un coste real. Muchas acciones pueden bonificarse con el crédito
          formativo de la empresa; te lo revisamos desde el primer momento.
        </p>
        <a href="/fundae" class="btn btn--outline">Más sobre bonificación <span class="arrow">→</span></a>
        <p class="note" style="margin-top:20px">{BONIF_NOTE}</p>
      </div>
      <div class="faq reveal">
        {
          fundaeFaqs.map(([q, a]) => (
            <details class="faq__item">
              <summary class="faq__q">{q}</summary>
              <p class="faq__a">{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  /* Hero */
  .qh-hero {
    overflow: hidden;
  }
  .qh-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 64px;
    align-items: center;
  }
  .qh-hero__title {
    font-size: 40px;
    line-height: 1.18;
  }
  .qh-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .qh-hero__facts {
    list-style: none;
    margin: 32px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
  }
  .qh-hero__facts li {
    font-size: 13.5px;
    color: var(--text-sec);
  }
  .qh-hero__facts strong {
    display: block;
    font-weight: 700;
    font-size: 26px;
    color: var(--green);
    line-height: 1.1;
  }

  /* Collage de fotos reales */
  .qh-collage {
    position: relative;
    max-width: 420px;
    margin: 0 auto 0 auto;
    padding: 0 0 48px 48px;
  }
  .qh-collage__main {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 40%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
  }
  .qh-collage__inset {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 42%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    border: 5px solid #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-hover);
  }
  .qh-collage__badge {
    position: absolute;
    top: 18px;
    right: -10px;
    max-width: 190px;
    background: #fff;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hover);
    padding: 10px 14px;
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--green-dark);
    border-left: 3px solid var(--green);
  }

  /* Cabecera de sección con subtítulo lateral */
  .qh-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 48px;
    margin-bottom: 30px;
  }
  .qh-head > div {
    max-width: 600px;
  }
  .qh-head__sub {
    max-width: 340px;
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-sec);
  }

  /* Tarjetas de servicio */
  .svc {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .svc__card {
    display: flex;
    flex-direction: column;
    padding: 26px 24px 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .svc__card:hover {
    border-color: var(--green);
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .svc__ico {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--green-soft);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .svc__ico svg {
    width: 22px;
    height: 22px;
  }
  .svc__title {
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .svc__desc {
    font-size: 14px;
    color: var(--text-sec);
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .svc__cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 13.5px;
    color: var(--green);
  }
  .svc__card--dark {
    background: var(--green-dark);
    border-color: var(--green-dark);
  }
  .svc__card--dark .svc__ico {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .svc__card--dark .svc__title,
  .svc__card--dark .svc__cta {
    color: #fff;
  }
  .svc__card--dark .svc__desc {
    color: rgba(255, 255, 255, 0.78);
  }

  /* Método — línea de tiempo */
  .steps {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 22px;
    height: 2px;
    background: linear-gradient(to right, var(--green), rgba(26, 92, 26, 0.18));
  }
  .steps__item {
    position: relative;
  }
  .steps__dot {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 6px #fff;
    margin-bottom: 18px;
  }
  .steps__title {
    font-weight: 700;
    font-size: 16.5px;
    color: var(--text);
    margin: 0 0 6px;
  }
  .steps__desc {
    font-size: 13.5px;
    color: var(--text-sec);
    line-height: 1.6;
    margin: 0;
  }

  /* Beneficios — banda oscura */
  .section--dark {
    background: var(--green-dark);
    border-bottom: none;
  }
  .gains {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 40px;
  }
  .gains li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .gains__check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .gains__check svg {
    width: 14px;
    height: 14px;
  }
  .gains__title {
    font-weight: 600;
    font-size: 16px;
    color: #fff;
    margin: 0 0 4px;
    line-height: 1.35;
  }
  .gains__desc {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.55;
    margin: 0;
  }

  /* FAQ en dos columnas */
  .faqwrap {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 56px;
    align-items: start;
  }
  .faq {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 6px 26px;
  }
  .faq__item:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
    cursor: pointer;
    padding: 20px 36px 20px 0;
    position: relative;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--green-soft);
    color: var(--green);
    font-size: 18px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .faq__item[open] .faq__q::after {
    content: '–';
    background: var(--green);
    color: #fff;
  }
  .faq__a {
    font-size: 15px;
    color: var(--text-sec);
    line-height: 1.7;
    margin: 0;
    padding: 0 36px 22px 0;
  }

  @media (max-width: 980px) {
    .qh-hero__grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .qh-hero__title {
      font-size: 32px;
    }
    .svc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .steps::before {
      top: 22px;
      bottom: 22px;
      left: 21px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(to bottom, var(--green), rgba(26, 92, 26, 0.18));
    }
    .steps__item {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 18px;
      padding-bottom: 22px;
    }
    .steps__dot {
      grid-row: span 2;
      margin-bottom: 0;
    }
    .steps__title {
      margin-top: 10px;
    }
    .gains {
      grid-template-columns: 1fr 1fr;
    }
    .faqwrap {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 600px) {
    .svc,
    .gains {
      grid-template-columns: 1fr;
    }
    .qh-collage {
      max-width: 340px;
      padding: 0 0 36px 36px;
    }
    .qh-collage__badge {
      right: 0;
    }
    .faq {
      padding: 4px 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__card {
      transition: none;
    }
    .svc__card:hover {
      transform: none;
    }
  }
</style>
