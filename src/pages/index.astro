---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import CasoClubMac from '../components/CasoClubMac.astro';
import { site } from '../data/site';
import { catalogo, BONIF_NOTE } from '../data/catalogo';

const filosofia = [
  'Menos desgaste',
  'Más pertenencia',
  'Mejor experiencia de equipo',
];

const beneficios = [
  ['Reduce el desgaste y el absentismo', 'Menos molestias físicas, menos estrés crónico y menos ausencias relacionadas con el entorno de trabajo.'],
  ['Mejora el clima y la colaboración', 'Un equipo que se cuida discute menos, se comunica mejor y rinde de forma más sostenible.'],
  ['Refuerza el sentimiento de pertenencia', 'El cuidado real de las personas se traduce en compromiso, identificación con la empresa y menor rotación.'],
  ['Centraliza servicios de bienestar', 'Formación, bienestar y cohesión coordinados por un solo equipo. Menos proveedores, más coherencia.'],
];

const totalItems = catalogo.reduce((n, c) => n + c.items.length, 0);

const proceso = ['Diagnóstico', 'Diseño', 'Gestión FUNDAE previa', 'Ejecución', 'Medición y cierre'];
---

<BaseLayout
  title="Bienestar corporativo y formación bonificable para empresas"
  description="Batmotrópicos activa personas para que los equipos funcionen mejor: formación bonificable FUNDAE, bienestar laboral, team building y wellness in company."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy reveal">
        <p class="eyebrow">Bienestar corporativo y formación bonificable para empresas · Mallorca</p>
        <h1 class="title">{site.claim}</h1>
        <p class="hero__sub">{site.subclaim}</p>
        <p class="hero__hook">
          Diseñado para reducir la rotación, el absentismo y el desgaste — y mejorar el clima de
          equipos que trabajan bajo presión.
        </p>
        <div class="hero__actions">
          <a href="/diagnostico" class="btn btn--primary">Hacer el diagnóstico (2 min) <span class="arrow">→</span></a>
          <a href="/catalogo" class="btn btn--outline">Ver catálogo</a>
        </div>
        <ul class="hero__pills">
          <li>Bonificable vía FUNDAE</li>
          <li>Primera propuesta ágil</li>
          <li>Presencial y online</li>
        </ul>
      </div>

      <div class="hero__media reveal">
        <div class="reel__frame">
          <video
            id="hero-reel"
            class="reel__video"
            src="/assets/video/hero-reel.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Sesión presencial de formación y bienestar laboral para equipos de empresa"
          ></video>
          <button type="button" class="reel__sound-btn" id="reel-sound-btn" aria-label="Ver la sesión real con sonido">
            <span class="reel__sound-ico" aria-hidden="true">▶</span>
            <span>Ver sesión real</span>
          </button>
          <p class="reel__caption">Sesión real de bienestar corporativo en empresa</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FRANJA DE SERVICIOS (acento verde oscuro bajo el hero) -->
  <section class="svcstrip">
    <div class="wrap">
      <div class="svcstrip__band reveal">
        <a href="/que-hacemos" class="svcstrip__item">
          <span class="svcstrip__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </span>
          <span class="svcstrip__body">
            <span class="svcstrip__t">Formación bonificable</span>
            <span class="svcstrip__d">Acciones que encajan en el crédito FUNDAE</span>
          </span>
        </a>
        <a href="/catalogo" class="svcstrip__item">
          <span class="svcstrip__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </span>
          <span class="svcstrip__body">
            <span class="svcstrip__t">Wellness in company</span>
            <span class="svcstrip__d">Fisioterapia, psicología y movilidad en la empresa</span>
          </span>
        </a>
        <a href="/team-building" class="svcstrip__item">
          <span class="svcstrip__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <span class="svcstrip__body">
            <span class="svcstrip__t">Team building y cohesión</span>
            <span class="svcstrip__d">Experiencias que activan y conectan al equipo</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- CASO REAL: Club Mac Alcúdia (prueba social arriba) -->
  <CasoClubMac ctaHref="/hoteles" ctaLabel="Ver la solución para hoteles" />

  <!-- QUÉ HACEMOS + CATÁLOGO -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="areas__head reveal">
        <div>
          <p class="eyebrow">Qué hacemos</p>
          <h2 class="h2" style="margin-bottom:0">Una sola propuesta para cuidar, formar y cohesionar al equipo</h2>
        </div>
        <p class="areas__sub">
          Formación, bienestar y cohesión coordinados por un solo equipo. Elige un área o explora
          las {totalItems} acciones del catálogo.
        </p>
      </div>
      <ul class="areas reveal">
        {
          catalogo.map((c) => (
            <li>
              <a href={`/catalogo#${c.id}`} class="area">
                <span class="area__letter" aria-hidden="true">{c.letter}</span>
                <span class="area__name">{c.tab}</span>
                <span class="area__count">{c.items.length} acciones</span>
                <span class="area__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="areas__foot reveal">
        <p class="note">{BONIF_NOTE}</p>
        <div class="areas__actions">
          <a href="/catalogo" class="btn btn--primary">Explorar el catálogo <span class="arrow">→</span></a>
          <a href="/que-hacemos" class="btn btn--outline">Conocer el enfoque</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FILOSOFÍA (contraste verde oscuro) -->
  <section class="section section--dark">
    <div class="wrap dark__grid">
      <div class="reveal">
        <p class="eyebrow eyebrow--light">Nuestra filosofía</p>
        <h2 class="h2 h2--light">
          Para empresas que no quieren hacer actividades sueltas, sino construir una cultura de
          cuidado medible.
        </h2>
      </div>
      <ul class="dark__list reveal">
        {
          filosofia.map((f, i) => (
            <li>
              <span class="dark__num">0{i + 1}</span>
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- EN EL TERRENO: mosaico de momentos reales -->
  <section class="section">
    <div class="wrap">
      <div class="field__head reveal">
        <div>
          <p class="eyebrow">En el terreno</p>
          <h2 class="h2" style="margin-bottom:0">Formación práctica, en el puesto real</h2>
        </div>
        <p class="field__sub">
          Nada de charlas eternas: trabajamos con el equipo, en su espacio y sobre los gestos de su
          día a día.
        </p>
      </div>

      <div class="field reveal">
        <figure class="field__tile field__tile--a">
          <img src="/assets/img/real/kokomo-diplomas.webp" alt="Equipo de restauración con sus diplomas tras completar una formación de bienestar laboral" width="1200" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Restauración</span>Equipo formado y certificado</figcaption>
        </figure>
        <figure class="field__tile field__tile--b">
          <img src="/assets/img/real/clubmac-calentamiento.webp" alt="Camareras de piso haciendo un calentamiento preventivo en grupo" width="640" height="1138" loading="lazy" decoding="async" />
          <figcaption><span>Hotel</span>Calentamiento antes del turno</figcaption>
        </figure>
        <figure class="field__tile field__tile--c">
          <img src="/assets/img/real/clubmac-grupo.webp" alt="Equipo de pisos de un hotel durante una sesión práctica de salud laboral" width="640" height="1138" loading="lazy" decoding="async" />
          <figcaption><span>Hotel</span>Aprender haciendo</figcaption>
        </figure>
        <figure class="field__tile field__tile--d">
          <img src="/assets/img/real/clubmac-placa.webp" alt="Colocación de la placa Empresa Saludable en el hotel junto a la responsable del equipo" width="640" height="1138" loading="lazy" decoding="async" />
          <figcaption><span>Reconocimiento</span>Entrega de la placa Empresa Saludable</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- POR QUÉ FUNCIONA: beneficios + pertenencia -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="reveal" style="max-width:720px">
        <p class="eyebrow">Por qué funciona</p>
        <h2 class="h2">Lo que gana la empresa</h2>
      </div>
      <div class="why">
        <figure class="why__quote reveal">
          <blockquote>El salario importa, pero no es suficiente para quedarse.</blockquote>
          <p>
            Cuando el sueldo deja de ser el problema, lo que retiene es sentir que se trabaja en un
            lugar que cuida a las personas y donde formar parte del equipo tiene sentido.
          </p>
          <figcaption>La cultura de cuidado no es un extra: es lo que hace que alguien quiera seguir.</figcaption>
        </figure>
        <ol class="why__list reveal">
          {
            beneficios.map(([t, d], i) => (
              <li>
                <span class="why__num">0{i + 1}</span>
                <div>
                  <h3 class="why__title">{t}</h3>
                  <p class="card-text">{d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- PROGRAMAS + CÓMO TRABAJAMOS -->
  <section class="section">
    <div class="wrap">
      <div class="reveal" style="max-width:720px">
        <p class="eyebrow">Programas</p>
        <h2 class="h2">Una estructura para cada tipo de empresa</h2>
        <p class="lead">
          Desde una acción puntual hasta un programa anual integral, con seguimiento y medición de
          resultados en cada nivel.
        </p>
      </div>
      <div class="progs reveal">
        <div class="progs__item card card--accent">
          <span class="progs__tag">Continuidad</span>
          <h3 class="progs__title">Plan Semestral</h3>
          <p class="progs__meta">6 meses · 6 acciones · 1 al mes</p>
          <p class="card-text">Una intervención mensual con hilo conductor, seguimiento trimestral y memoria de resultados al cierre. Para empezar con estructura y sin sobredimensionar.</p>
        </div>
        <div class="progs__item card card--accent progs__item--featured">
          <span class="progs__tag progs__tag--light">Recomendado</span>
          <h3 class="progs__title">Plan Anual</h3>
          <p class="progs__meta">12 meses · 12 acciones · evaluación semestral</p>
          <p class="card-text">Una acción mensual —formación, bienestar o cohesión según necesidad—, evaluación a mitad de año y propuesta de continuidad basada en resultados.</p>
        </div>
        <div class="progs__item card card--accent">
          <span class="progs__tag">Integral</span>
          <h3 class="progs__title">Plan Integral Anual</h3>
          <p class="progs__meta">Formación + bienestar + team building + medición</p>
          <p class="card-text">Todo integrado en un único programa anual con diagnóstico inicial y medición de impacto. Para empresas con más volumen, varias sedes o necesidades combinadas.</p>
        </div>
      </div>

      <div class="flow reveal">
        <span class="flow__label">Cómo trabajamos</span>
        <ol class="flow__steps">
          {
            proceso.map((st, i) => (
              <li>
                <span class="flow__dot">{i + 1}</span>
                {st}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="reveal" style="margin-top:30px">
        <a href="/diagnostico" class="btn btn--primary">Empezar por el diagnóstico <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- PLACA + QUIÉN ESTÁ DETRÁS -->
  <section class="section section--soft">
    <div class="wrap duo">
      <article class="duo__card reveal">
        <div class="duo__media duo__media--plaque">
          <img
            src="/assets/icons/placa-empresa-saludable-2026.webp"
            alt="Placa Empresa Saludable 2026 de Batmotrópicos: esta empresa ha implementado un programa de formación en salud física y mental para sus trabajadores."
            width="2000"
            height="1334"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="duo__body">
          <p class="eyebrow">Reconocimiento</p>
          <h2 class="duo__title">Placa Empresa Saludable</h2>
          <p class="card-text">
            Tras una acción formativa o un programa de bienestar, la empresa recibe una placa que
            hace visible su compromiso con la salud física y mental de su equipo.
          </p>
        </div>
      </article>

      <article class="duo__card reveal">
        <div class="duo__media">
          <img
            src="/assets/img/real/Fisio.jpg"
            alt="Juan Luis Rodríguez Ávila, fundador de Batmotrópicos"
            width="942"
            height="1672"
            loading="lazy"
            decoding="async"
            class="duo__portrait"
          />
        </div>
        <div class="duo__body">
          <p class="eyebrow">Quién está detrás</p>
          <h2 class="duo__title">Juan Luis Rodríguez Ávila</h2>
          <p class="card-text">
            Fisioterapeuta con años de experiencia en hostelería y trabajo directo con equipos.
            Batmotrópicos nace de juntar las dos cosas: salud aplicada al trabajo real.
          </p>
          <a href="/quienes-somos" class="duo__link">Conocer la historia <span class="arrow">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<script is:inline>
  (function () {
    var hero = document.getElementById('hero-reel');
    var soundBtn = document.getElementById('reel-sound-btn');
    if (!hero) return;

    // Pausa cualquier otro vídeo con sonido para que no suenen dos a la vez.
    function pauseOthers(except) {
      document.querySelectorAll('video').forEach(function (v) {
        if (v !== except && !v.muted && !v.paused) v.pause();
      });
    }

    // "Ver sesión real": activa sonido y controles sobre el mismo reel.
    if (soundBtn) {
      soundBtn.addEventListener('click', function () {
        hero.loop = false;
        hero.muted = false;
        hero.controls = true;
        try { hero.currentTime = 0; } catch (e) {}
        pauseOthers(hero);
        var p = hero.play();
        if (p && typeof p.catch === 'function') p.catch(function () {});
        soundBtn.hidden = true;
      });
    }

    // Si se reproduce cualquier vídeo con sonido, pausamos el resto.
    document.querySelectorAll('video').forEach(function (v) {
      v.addEventListener('play', function () {
        if (!v.muted) pauseOthers(v);
      });
      v.addEventListener('volumechange', function () {
        if (!v.muted && v.volume > 0) pauseOthers(v);
      });
    });
  })();
</script>

<style>
  /* Hero */
  .hero {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding-top: 84px;
    padding-bottom: 76px;
  }
  .hero__sub {
    font-size: 18px;
    color: var(--text-sec);
    line-height: 1.65;
    max-width: 520px;
    margin: 0 0 18px;
  }
  .hero__hook {
    font-weight: 500;
    font-size: 14.5px;
    color: var(--green-dark);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 0 30px;
    padding-left: 16px;
    border-left: 2px solid var(--green);
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__pills {
    list-style: none;
    margin: 30px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .hero__pills li {
    position: relative;
    font-weight: 500;
    font-size: 13px;
    color: var(--text-sec);
  }
  .hero__pills li:not(:first-child)::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 4px;
    background: var(--line);
    transform: translateY(-50%);
  }
  /* Hero media — vídeo vertical protagonista */
  .hero__media {
    display: flex;
    justify-content: center;
  }
  .reel__frame {
    position: relative;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }
  .reel__video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    background: #000;
    box-shadow: var(--shadow-soft);
  }
  .reel__caption {
    font-size: 12px;
    color: var(--text-sec);
    text-align: center;
    margin: 10px 0 0;
  }

  /* Franja de servicios (acento verde oscuro) */
  .svcstrip {
    padding: 0 0 8px;
    margin-top: -34px;
    position: relative;
    z-index: 2;
  }
  .svcstrip__band {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--green-dark);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
    overflow: hidden;
  }
  .svcstrip__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 24px;
    text-decoration: none;
    color: #fff;
    transition: background 0.18s ease;
  }
  .svcstrip__item:not(:last-child) {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }
  .svcstrip__item:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .svcstrip__ico {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .svcstrip__ico svg {
    width: 20px;
    height: 20px;
  }
  .svcstrip__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .svcstrip__t {
    font-weight: 600;
    font-size: 14.5px;
    color: #fff;
    line-height: 1.25;
  }
  .svcstrip__d {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.4;
  }

  .reel__sound-btn {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border: none;
    border-radius: 40px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--green);
    font-family: var(--font);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s, background 0.15s;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }
  .reel__sound-btn:hover {
    transform: translateX(-50%) translateY(-2px);
    background: #fff;
  }
  .reel__sound-ico {
    font-size: 11px;
    line-height: 1;
  }
  .reel__sound-btn[hidden] {
    display: none;
  }

  /* Programas premium */
  .progs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  .progs__item {
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
  }
  .progs__item--featured {
    border-color: var(--green);
    box-shadow: 0 0 0 1px var(--green);
  }
  .progs__tag {
    display: inline-block;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-accent);
    margin-bottom: 14px;
  }
  .progs__tag--light {
    color: #fff;
    background: var(--green);
    padding: 3px 10px;
    border-radius: 30px;
  }
  .progs__title {
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
    margin: 0 0 6px;
    line-height: 1.25;
  }
  .progs__meta {
    font-weight: 600;
    font-size: 12.5px;
    color: var(--green);
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }

  /* Filosofía — sección de contraste verde oscuro */
  .section--dark {
    background: var(--green-dark);
    border-bottom: none;
  }
  .dark__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }
  .dark__grid h2 {
    margin-bottom: 0;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .dark__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .dark__list li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    font-weight: 600;
    font-size: 17px;
    color: #fff;
  }
  .dark__num {
    font-weight: 700;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.04em;
  }

  /* En el terreno — mosaico */
  .field__head {
    display: flex;
