---
// Ficha de paciente en español (página oculta: noindex, fuera del menú).
// Versión en inglés: /paciente/en. El formulario vive en FichaPaciente.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import FichaPaciente from '../components/FichaPaciente.astro';
import { TEXTS } from '../data/fichaPaciente';

const t = TEXTS.es;
---

<BaseLayout title={t.metaTitle} description={t.metaDesc} path="/paciente" lang="es" noindex minimal>
  <FichaPaciente lang="es" />
</BaseLayout>
