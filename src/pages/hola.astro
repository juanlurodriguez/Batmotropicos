---
// Tarjeta de contacto para networking (página oculta: noindex, fuera del menú).
// Es el destino de las tarjetas NFC y del QR: batmotropicos.com/hola
// La ficha descargable (.vcf) se genera en juanlu.vcf.ts con los mismos datos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, contacto } from '../data/site';

const WA_TEXT = 'Hola Juanlu, te escribo desde tu tarjeta. Soy ___ de ___.';
const whatsapp = `https://wa.me/${contacto.telefonoIntl.replace('+', '')}?text=${encodeURIComponent(WA_TEXT)}`;
---

<BaseLayout
  title={contacto.nombre}
  description={`Contacto de ${contacto.nombre}, fundador de ${site.name}: guarda su ficha, conecta en LinkedIn o escríbele por WhatsApp.`}
  path="/hola"
  noindex
  minimal
>
  <section class="hola">
    <img
      src="/assets/img/real/juanlu.webp"
      alt={contacto.nombre}
      class="hola__photo"
      width="1200"
      height="1200"
      decoding="async"
    />
    <h1 class="hola__name">{contacto.nombre}</h1>
    <p class="hola__role">Fisioterapeuta · Fundador de {site.name} {site.tagline}</p>
    <p class="hola__claim">{site.claim}</p>

    <div class="hola__actions">
      <a href="/juanlu.vcf" class="btn btn--primary hola__btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="10" cy="8" r="4"></circle>
          <path d="M2 21a8 8 0 0 1 13.3-6"></path>
          <path d="M19 15v6M16 18h6"></path>
        </svg>
        Guardar mi contacto
      </a>
      <a href={contacto.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn--outline hola__btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
        </svg>
        Conectar en LinkedIn
      </a>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--outline hola__btn">
        <img src="/assets/icons/whatsapp.svg" alt="" width="20" height="20" />
        Escribirme por WhatsApp
      </a>
    </div>

    <nav class="hola__links" aria-label="Más sobre Batmotrópicos">
      <a href="/">Web</a>
      <a href="/hoteles">Hoteles</a>
      <a href="/fundae">Formación FUNDAE</a>
      <a href="/casos-de-exito">Casos de éxito</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .hola {
    max-width: 420px;
    margin: 0 auto;
    padding: 36px 20px 48px;
    text-align: center;
  }
  .hola__photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 18px;
    border: 3px solid var(--green-soft);
    box-shadow: var(--shadow-soft);
  }
  .hola__name {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 6px;
  }
  .hola__role {
    color: var(--green);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 14px;
  }
  .hola__claim {
    color: var(--text-sec);
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 28px;
  }
  .hola__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hola__btn {
    justify-content: center;
    width: 100%;
    padding: 15px 20px;
  }
  .hola__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin-top: 30px;
    font-size: 14px;
  }
  .hola__links a {
    color: var(--text-sec);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hola__links a:hover {
    color: var(--green);
  }
</style>
